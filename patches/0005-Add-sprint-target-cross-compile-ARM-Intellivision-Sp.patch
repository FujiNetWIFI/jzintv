diff --git a/src/Makefile.sprint b/src/Makefile.sprint
new file mode 100644
index 0000000..bfb7c3d
--- /dev/null
+++ b/src/Makefile.sprint
@@ -0,0 +1,171 @@
+##############################################################################
+## ARM 32-bit cross-compilation Makefile for jzintv (Sprint Edition)
+##############################################################################
+
+#### Container Creation ####
+#### "distrobox create --name arm-sdl2 --image debian:bullseye"
+#### "distrobox enter arm-sdl2"
+#### echo $CONTAINER_ID
+
+# Update e installa
+#### sudo apt update
+
+# Aggiungi ARM
+#### sudo dpkg --add-architecture armhf
+#### sudo apt update
+
+# Installa tutto
+#### sudo apt install -y gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf \
+     crossbuild-essential-armhf make zip libsdl2-dev:armhf libcapstone4
+
+# Verifica
+#### arm-linux-gnueabihf-gcc --version
+
+##############################################################################
+## Project directory structure
+##############################################################################
+B = ../bin
+L = ../lib
+R = ../rom
+
+##############################################################################
+## ARM Cross-compilation setup
+##############################################################################
+CROSS_COMPILE = arm-linux-gnueabihf-
+CC  = $(CROSS_COMPILE)gcc -std=gnu99
+CXX = $(CROSS_COMPILE)g++ -std=c++14
+AR  = $(CROSS_COMPILE)ar
+STRIP = $(CROSS_COMPILE)strip
+
+# Set "X" to be the executable extension, and "O" to be the object extension.
+X =
+O = o
+
+# Set "RM" to be the remove/delete command
+RM = rm -f
+
+##############################################################################
+## Project-wide build flags
+##############################################################################
+
+# Feature flags
+ENABLE_INTV2PC = 0
+ENABLE_CGC = 0
+GNU_READLINE = 0
+GNU_READLINE_STATIC_HACK = 1
+
+# ARM-specific PKG_CONFIG setup for SDL2
+PKG_CONFIG_PATH = /usr/lib/arm-linux-gnueabihf/pkgconfig
+SDL2_CFLAGS := $(shell PKG_CONFIG_PATH=$(PKG_CONFIG_PATH) pkg-config --cflags sdl2) -DUSE_SDL=2
+SDL2_LFLAGS := $(shell PKG_CONFIG_PATH=$(PKG_CONFIG_PATH) pkg-config --libs sdl2)
+
+# Optimization flags for ARM
+OPT_FLAGS = -O2 -march=armv7-a -mfpu=neon-vfpv4 -mfloat-abi=hard
+
+# Compiler flags
+WARN = -Wall -Wextra -Wno-unused-parameter
+WARNXX = $(WARN)
+DEF_FLAGS =
+LTO =
+
+CFLAGS   = $(OPT_FLAGS) $(WARN) -I. -I..   $(DEF_FLAGS) $(SDL2_CFLAGS)
+CXXFLAGS = $(OPT_FLAGS) $(WARNXX) -I. -I..  $(DEF_FLAGS) $(SDL2_CFLAGS)
+
+# Linker flags - forza dl e rt esplicitamente
+LFLAGS = -Wl,--no-as-needed -ldl -lrt -lpthread -Wl,--as-needed -no-pie
+LFLAGS += -Wl,--gc-sections
+
+# GNU Readline support
+ifeq ($(GNU_READLINE),1)
+RL_CFLAGS = -DUSE_GNU_READLINE
+CFLAGS += $(RL_CFLAGS)
+CXXFLAGS += $(RL_CFLAGS)
+RL_LFLAGS = -lreadline -lncurses
+endif
+
+# GNU Readline static hack to avoid unnecessary dependencies
+ifeq ($(GNU_READLINE_STATIC_HACK),1)
+RL_LFLAGS += -Wl,--defsym=setpwent=0 -Wl,--defsym=getpwent=0
+RL_LFLAGS += -Wl,--defsym=endpwent=0
+RL_LFLAGS += -Wl,--defsym=getpwuid=0 -Wl,--defsym=getpwnam=0
+endif
+
+##############################################################################
+## Build targets
+##############################################################################
+
+OBJS      = jzintv.$(O)
+PROG_SDL2 = $(B)/jzintv
+TOCLEAN  += $(PROG_SDL2)
+TOCLEAN  += core
+
+##############################################################################
+## ARM-specific CGC support (DEVE ESSERE PRIMA di Makefile.common)
+##############################################################################
+
+ifeq ($(ENABLE_CGC),1)
+OBJS += pads/pads_intv2pc.$(O)
+endif
+
+##############################################################################
+## Generic build-rules
+##############################################################################
+
+all: build
+
+$(PROG_SDL2): $(OBJS) $(OBJS_SDL2)
+	@echo "Linking jzintv for ARM 32-bit..."
+	$(CXX) -o $(PROG_SDL2) $(OBJS) $(OBJS_SDL2) $(CFLAGS) $(SDL2_LFLAGS) $(LFLAGS) $(RL_LFLAGS)
+	@echo "Build complete!"
+	@file $(PROG_SDL2)
+	@echo ""
+	@echo "Dependencies:"
+	@$(CROSS_COMPILE)readelf -d $(PROG_SDL2) | grep NEEDED
+
+clean:
+	$(RM) $(OBJS)
+	$(RM) $(OBJS_SDL2)
+	$(RM) $(TOCLEAN)
+
+%.$(O): %.c
+	$(CC) -o $@ $(CFLAGS) -c $<
+
+%.$(O): %.cpp
+	$(CXX) -o $@ $(CXXFLAGS) -c $<
+
+%.s: %.c
+	$(CC) -fverbose-asm -S -o $@ $(CFLAGS) -c $<
+
+##############################################################################
+## CGC compilation rule
+##############################################################################
+
+ifeq ($(ENABLE_CGC),1)
+pads/pads_intv2pc.$(O): pads/pads_intv2pc. c
+	$(CC) -O2 -o $@ $(CFLAGS) -c $<
+endif
+
+##############################################################################
+## Include common Makefile
+##############################################################################
+include Makefile.common
+
+##############################################################################
+## Build declaration
+##############################################################################
+build: jzIntv SDK-1600
+
+##############################################################################
+## Info target for debugging
+##############################################################################
+info:
+	@echo "CC:            $(CC)"
+	@echo "CXX:          $(CXX)"
+	@echo "CFLAGS:       $(CFLAGS)"
+	@echo "CXXFLAGS:     $(CXXFLAGS)"
+	@echo "SDL2_CFLAGS:  $(SDL2_CFLAGS)"
+	@echo "SDL2_LFLAGS:  $(SDL2_LFLAGS)"
+	@echo "LFLAGS:       $(LFLAGS)"
+	@echo "RL_LFLAGS:    $(RL_LFLAGS)"
+	@echo "OBJS:         $(OBJS)"
+	@echo "OBJS_SDL2:    $(OBJS_SDL2)"
