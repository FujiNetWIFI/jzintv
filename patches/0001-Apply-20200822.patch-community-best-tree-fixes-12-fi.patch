+            if (argv0[2] == PATH_SEP || argv0[2] == '/')
             {
                 new_exe_path = strdup(argv0);
                 goto got_exe_path;
@@ -745,6 +756,10 @@ got_exe_path:
     /*  Possible late failure mode: We can't find PATH_SEP.                 */
