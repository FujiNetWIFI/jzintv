         return 1;
 
     /* Look for a prefix of the form "VOL:".  Allow everything but the      */
@@ -635,12 +640,18 @@ macosx_fail:
 
     if (PLAT_WIN32)
     {
+        if (argv0[0] == '/')
+        {
+            new_exe_path = strdup(argv0);
+            goto got_exe_path;
+        }
+
         if (strlen(argv0) > 3 && isalpha(argv0[0]) && argv0[1] == ':')
         {
             /* ------------------------------------------------------------ */
             /*  Common case: C:\path\to\jzintv.exe                          */
             /* ------------------------------------------------------------ */
