--- a/src/file/file.c
+++ b/src/file/file.c
@@ -236,12 +236,17 @@ int is_absolute_path(const char *fname)
     if (fname[0] == PATH_SEP)
         return 1;
 
+    /* PATH_SEP is backslash on PLAT_WIN32, but allow forward slash as well. */
+    if (PLAT_WIN32 && fname[0] == '/')
