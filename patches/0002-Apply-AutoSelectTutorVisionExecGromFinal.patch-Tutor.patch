+LOCAL const char *optchars= "b:E:e:G:g:s::t::u::f::F:?dhlqr:P::x::z:a:w:B:C:M:m:"
                             "v::W::V::i::I::c:D:p:J:j::";
 
 /* ======================================================================== */
@@ -547,18 +549,19 @@ void cfg_init(cfg_t *cfg, int argc, char * argv_orig[])
     int jlp_flash = -1;
     LZFILE *f;
     int silent = 0;
-    char *debug_symtbl   = NULL;
-    char *debug_script   = NULL;
-    char *debug_srcmap   = NULL;
